# Pulseboard needs exactly these six variables, locally and in production.
# Copy this file to .env.local and replace the placeholders. Never commit real values.

# MongoDB Atlas connection string. It MUST include the database name after the host
# (here: "pulseboard"); the app derives its database from this URI.
MONGODB_URI="mongodb+srv://pulseboard-app:REPLACE_ME@cluster0.example.mongodb.net/pulseboard?retryWrites=true&w=majority"

# Aiven for Apache Kafka: comma-separated broker host:port addresses (the "Service URI").
KAFKA_BROKERS="kafka-example-project.aivencloud.com:12345"

# Aiven mutual TLS credentials. Paste the PEM text with real line breaks, or on one line with
# \n escapes as shown. Certificate verification is always on.
KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_ME_CA_CERTIFICATE\n-----END CERTIFICATE-----"
KAFKA_CLIENT_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_ME_CLIENT_CERTIFICATE\n-----END CERTIFICATE-----"
KAFKA_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME_CLIENT_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Long random secret (at least 24 characters) that protects ingestion, simulation,
# pause/resume, and replay. Generate one with: openssl rand -base64 32
ADMIN_TOKEN="REPLACE_ME_WITH_A_LONG_RANDOM_TOKEN"
